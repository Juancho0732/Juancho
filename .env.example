# Copiar a .env y completar con valores reales. Nunca commitear .env con claves reales.
# Ver docs/00-fase0-analisis.md sección 12 para el detalle de cada variable.

# --- Cliente (Expo las incluye en el bundle; son públicas por diseño de Supabase,
#     protegidas por Row Level Security, NO por secreto) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo servidor (secretos de la Supabase Edge Function `ai-search`).
#     Configurar con `supabase secrets set`, JAMÁS en el bundle de la app. ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
SUPABASE_SERVICE_ROLE_KEY=
# Control de costo de IA (auditoría de beta-readiness, Prioridad 9) -- ver
# supabase/functions/ai-search/rateLimiter.ts para el porqué de cada límite.
AI_RATE_LIMIT_PER_MINUTE=5
AI_DAILY_LIMIT_PER_USER=50
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=60

# --- Solo build nativo de Android (app.config.ts la vuelca en AndroidManifest.xml
#     al hacer `expo prebuild`/EAS Build; NO llega al bundle JS, no lleva EXPO_PUBLIC_).
#     Necesaria para que el mapa se vea en Android (react-native-maps usa Google Maps
#     ahí). En iOS no hace falta: usa Apple Maps sin costo. Ver README "Mapas". ---
GOOGLE_MAPS_API_KEY=
