# Copiar a .env y completar con valores reales. Nunca commitear .env con claves reales
# (está en .gitignore). Ver docs/INFRA_READINESS.md sección 2 para el detalle completo
# de cada variable, incluida la distinción PUBLIC / SECRET / SERVER ONLY.
#
# Resumen de las tres categorías:
#   PUBLIC       -- termina en el bundle de la app (visible para cualquiera que la
#                    instale/inspeccione). Solo debe llevar acá algo diseñado para ser
#                    público (protegido por RLS o por restricciones de la propia API).
#   BUILD ONLY   -- solo la usa la config nativa al generar el build (app.config.ts /
#                    `expo prebuild` / EAS Build). Nunca llega al bundle de JavaScript.
#   SERVER ONLY  -- solo la usa la Edge Function `ai-search`, corriendo en la
#                    infraestructura de Supabase. Jamás debe estar en el cliente.

# ============================================================================
# PUBLIC -- cliente (Expo las incluye en el bundle; son públicas por diseño de
# Supabase, protegidas por Row Level Security, NO por secreto)
# ============================================================================
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# BUILD ONLY -- solo build nativo de Android (app.config.ts la vuelca en
# AndroidManifest.xml al hacer `expo prebuild`/EAS Build; NO llega al bundle JS,
# no lleva EXPO_PUBLIC_). Necesaria para que el mapa se vea en Android
# (react-native-maps usa Google Maps ahí). En iOS no hace falta: usa Apple Maps
# sin costo. Ver README "Mapas" y docs/INFRA_READINESS.md sección 6.
# ============================================================================
GOOGLE_MAPS_API_KEY=

# ============================================================================
# SERVER ONLY -- secretos/config de la Supabase Edge Function `ai-search`.
# En un proyecto Supabase real, configurar con `supabase secrets set NOMBRE=valor`
# (o desde el dashboard: Project Settings -> Edge Functions -> Secrets).
# JAMÁS en el bundle de la app ni en un .env que se commitee.
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY NO están en esta
# lista: Supabase las inyecta automáticamente en el entorno de ejecución de
# cada Edge Function ya desplegada -- no hace falta (ni se puede) configurarlas
# a mano con `supabase secrets set`. Sí hace falta ponerlas en un .env local
# si se corre `supabase functions serve` para desarrollar la función en la
# máquina local (ahí no hay ese auto-inyectado); en ese caso
# SUPABASE_SERVICE_ROLE_KEY sigue siendo secreta incluso en local.
# ============================================================================
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
# Control de costo de IA (auditoría de beta-readiness, Prioridad 9) -- ver
# supabase/functions/ai-search/rateLimiter.ts para el porqué de cada límite.
# No son secretos (son límites numéricos), pero solo los usa la Edge Function.
AI_RATE_LIMIT_PER_MINUTE=5
AI_DAILY_LIMIT_PER_USER=50
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=60
