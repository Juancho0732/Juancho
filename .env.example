# Copiar a .env y completar con valores reales. Nunca commitear .env con claves reales.
# Ver docs/00-fase0-analisis.md sección 12 para el detalle de cada variable.

# --- Cliente (Expo las incluye en el bundle; son públicas por diseño de Supabase,
#     protegidas por Row Level Security, NO por secreto) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo servidor (secretos de la Supabase Edge Function `ai-search`).
#     Configurar con `supabase secrets set`, JAMÁS en el bundle de la app. ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
SUPABASE_SERVICE_ROLE_KEY=
AI_RATE_LIMIT_PER_MINUTE=5
